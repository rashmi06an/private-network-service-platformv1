# =============================================================
# TLS configuration for the nginx edge — Mac 2
# Included from nginx.conf inside the `listen 443 ssl` server block.
# Project: Private Network Service Platform (Team 1)
# =============================================================

# Certificate + private key for app.team1.test / api.team1.test.
# Paths below assume Homebrew nginx on Apple Silicon; adjust if needed.
ssl_certificate     /opt/homebrew/etc/nginx/certs/app.team1.test.pem;
ssl_certificate_key /opt/homebrew/etc/nginx/certs/app.team1.test-key.pem;

# Modern, safe protocol/cipher selection.
ssl_protocols       TLSv1.2 TLSv1.3;
ssl_ciphers         HIGH:!aNULL:!MD5;
ssl_prefer_server_ciphers on;

# Session cache improves handshake performance on repeat visits.
ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 10m;

# =============================================================
# HOW TO GENERATE THE CERTIFICATE
# =============================================================
#
# Option 1 — mkcert (recommended; installs a trusted local CA):
#
#   brew install mkcert nss
#   mkcert -install                       # adds local CA to the trust store
#   mkdir -p /opt/homebrew/etc/nginx/certs
#   cd /opt/homebrew/etc/nginx/certs
#   mkcert app.team1.test api.team1.test
#   # produces app.team1.test.pem (+ key); rename to match paths above.
#
#   On every CLIENT Mac, run `mkcert -install` (or import the CA from
#   "$(mkcert -CAROOT)/rootCA.pem") so curl/browser trust the cert
#   WITHOUT the -k flag.
#
# Option 2 — OpenSSL self-signed (needs manual trust on each client):
#
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout app.team1.test-key.pem \
#     -out    app.team1.test.pem \
#     -subj   "/CN=app.team1.test" \
#     -addext "subjectAltName=DNS:app.team1.test,DNS:api.team1.test"
#
#   # Trust it on each client Mac:
#   sudo security add-trusted-cert -d -r trustRoot \
#     -k /Library/Keychains/System.keychain app.team1.test.pem
#
# =============================================================
# TLS HANDSHAKE (be ready to explain for Task E):
#   ClientHello -> ServerHello -> Certificate -> Key Exchange -> Finished
# After the handshake, application data (HTTP) is encrypted, which is
# why the HTTP payload is not readable in the Wireshark capture.
# =============================================================
