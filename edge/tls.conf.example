# =============================================================
# TLS configuration for nginx edge — Mac 2
# =============================================================

ssl_certificate     /opt/homebrew/etc/nginx/certs/app.team1.test.pem;
ssl_certificate_key /opt/homebrew/etc/nginx/certs/app.team1.test-key.pem;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers HIGH:!aNULL:!MD5;
ssl_prefer_server_ciphers on;

ssl_session_cache shared:SSL:10m;
ssl_session_timeout 10m;
ssl_session_tickets off;