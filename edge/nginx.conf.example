# =============================================================
# nginx edge configuration — Mac 2
# Reverse proxy + round-robin load balancer + TLS termination
# Project: Private Network Service Platform (Team 1)
#
# Replace the placeholders before use:
#   MAC3_IP_HERE  -> private LAN IP of Mac 3 (Backend A)
#   MAC4_IP_HERE  -> private LAN IP of Mac 4 (Backend B)
#
# If you cannot bind to 80/443, use 8080/8443 instead
# (no marks are deducted for this substitution).
# =============================================================

# Round-robin load balancer across the two backends.
# Round-robin is the default strategy; swap to `least_conn;`
# if you want to demonstrate a different one.
upstream team1_backends {
    server MAC3_IP_HERE:3001;   # Backend A (Mac 3)
    server MAC4_IP_HERE:3002;   # Backend B (Mac 4)
}

    # ---------------------------------------------------------
    # HTTP -> HTTPS redirect
    # ---------------------------------------------------------
    server {
        listen 8080;
        server_name app.team1.test api.team1.test;

        return 301 https://$host:8443$request_uri;
    }

    # ---------------------------------------------------------
    # HTTPS edge / TLS termination
    # ---------------------------------------------------------
    server {
        listen 8443 ssl;
        http2 on;

        server_name app.team1.test api.team1.test;

        include /opt/homebrew/etc/nginx/tls.conf;

        location / {
            proxy_pass http://team1_backends;

            proxy_http_version 1.1;

            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # -----------------------------------------------------
        # HTTP caching demonstration
        # -----------------------------------------------------
        location = /api/status {
            proxy_pass http://team1_backends;

            proxy_http_version 1.1;

            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            add_header Cache-Control "public, max-age=60";
            etag on;
        }
    }
}