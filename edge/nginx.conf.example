# Historical Phase 1 addresses - Team Scout Regiment
# Primary and standby use identical routing/TLS; only X-Edge identifies the host.
worker_processes auto;
events { worker_connections 1024; }
http {
    include mime.types;
    default_type application/octet-stream;
    upstream team1_backends {
        zone team1_backends 256k;
        server 10.7.21.15:3001;
        server 10.7.23.47:3002;
    }
    server {
        listen 8080;
        server_name app.team1.test api.team1.test;
        return 301 https://$host:8443$request_uri;
    }
    server {
        listen 8443 ssl;
        http2 on;
        server_name app.team1.test api.team1.test;
        include /opt/homebrew/etc/nginx/tls.conf;
        add_header X-Edge "phase1-mac2" always;
        # One location preserves X-Edge inheritance on every endpoint.
        # Cache-Control and ETag come from /api/cache-demo in the backends.
        location / {
            proxy_pass http://team1_backends;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

        }
    }
}
