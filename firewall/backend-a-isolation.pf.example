# =============================================================
# Private Network Service Platform - Team Scout Regiment
# Phase 2 / Extension C — Service isolation (Backend A, Mac 3)
#
# Goal: ONLY the edge (Mac 2, 10.7.25.25) may reach backend port
# 3001. Any other client Mac connecting directly to :3001 is
# blocked. This proves clients must go through the edge.
#
# Self-contained pf ruleset (does not lock out other traffic):
# everything else is allowed; only port 3001 is restricted.
# Loaded into a named anchor so it is easy to roll back.
# =============================================================

# Keep loopback unaffected (local testing on the backend itself)
set skip on lo0

# 1) The edge IS allowed to reach the backend  (quick = stop here)
pass  in quick proto tcp from 10.7.25.25 to any port 3001

# 2) Everyone else is blocked from the backend port
block in quick proto tcp from any to any port 3001

# 3) All other traffic is unaffected
pass in all
pass out all
