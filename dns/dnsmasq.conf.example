# Private DNS configuration for Team 1

# Listen only on the project LAN interface/IP
# Replace with actual values during setup

listen-address=127.0.0.1,MAC1_IP_HERE

# Do not use /etc/resolv.conf automatically
no-resolv

# Project domain records
address=/app.team1.test/MAC2_IP_HERE
address=/api.team1.test/MAC2_IP_HERE


