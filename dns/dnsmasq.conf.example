# Private DNS configuration for Team 1

# Listen on localhost and the Mac 1 LAN IP (the DNS server)
listen-address=127.0.0.1,10.7.17.21

# Do not use /etc/resolv.conf automatically
no-resolv

# Project domain records -> Mac 2 (nginx edge)
address=/app.team1.test/10.7.7.9
address=/api.team1.test/10.7.7.9
