# Phase 2 private-zone resolver. Both hosts read the same records file format.
# Install /opt/homebrew/etc/team1-project.hosts from dns/project.hosts too.
port=53
interface=en0
listen-address=127.0.0.1,10.7.27.247
bind-interfaces
no-resolv
no-hosts
local=/team1.test/
local-ttl=30
addn-hosts=/opt/homebrew/etc/team1-project.hosts
pid-file=/opt/homebrew/var/run/dnsmasq-team1.pid
# No public DNS upstream is needed: clients use a scoped /etc/resolver entry.
# Reload hosts with SIGHUP after a record edit; do not restart for each cutover.
